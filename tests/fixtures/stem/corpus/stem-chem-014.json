    "correct_steps": [
      "C₃H₈(g) + 5O₂(g) → 3CO₂(g) + 4H₂O(l)",
      "4 × 2 = 8",
      "5 × 2 = 10 = 3 × 2 + 4 = 10",
      "n(C₃H₈) = 4.4 g ÷ 44 g mol⁻¹ = 0.10 mol",
      "n(CO₂) = 3 × 0.10 = 0.30 mol",
      "m(CO₂) = 0.30 × 44 = 13.2 g",
      "13.2 g ≈ 13 g"
