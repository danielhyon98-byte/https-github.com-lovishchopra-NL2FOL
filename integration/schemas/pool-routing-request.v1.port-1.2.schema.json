{
  "$defs": {
    "PoolFeatures": {
      "additionalProperties": false,
      "description": "The size of a dossier (or of one part of a combined answer) as the flash decision maker prices it: its journaled\ntransfers, their characters (envelopes, receipts and raw texts as journaled), whether its content is STEM and how many\ntranslations it carries (which compositions of the overseer's knowledge pack it needs). Counts only.",
      "properties": {
        "chars": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Chars",
          "type": "integer"
        },
        "stem": {
          "title": "Stem",
          "type": "boolean"
        },
        "transfers": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Transfers",
          "type": "integer"
        },
        "translations": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Translations",
          "type": "integer"
        }
      },
      "required": [
        "transfers",
        "chars",
        "stem",
        "translations"
      ],
      "title": "PoolFeatures",
      "type": "object"
    },
    "PoolItemFeatures12": {
      "additionalProperties": false,
      "description": "One dossier at pool port 1.2: its 1.1 features, its size (``None``: not measured) and, for a combined answer, its\nN >= 2 sources (in the order their answers were first delivered) and its merged part; never its key or a text.",
      "properties": {
        "advised": {
          "default": false,
          "title": "Advised",
          "type": "boolean"
        },
        "features": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolFeatures"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "item_id": {
          "pattern": "^d[1-9][0-9]{0,5}$",
          "title": "Item Id",
          "type": "string"
        },
        "merged": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolPartFeatures"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repeated_faults": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Repeated Faults",
          "type": "integer"
        },
        "risk_records": {
          "items": {
            "enum": [
              "named_defect",
              "writer_assumption",
              "unchecked_source",
              "stem_method",
              "encoding_conflict",
              "contradiction",
              "withheld_verdict",
              "rejection",
              "diagnosis_incomplete",
              "integrity_error"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Risk Records",
          "type": "array"
        },
        "risk_signals": {
          "items": {
            "enum": [
              "named_defect",
              "writer_assumption",
              "unchecked_source",
              "stem_method",
              "encoding_conflict",
              "contradiction",
              "withheld_verdict",
              "rejection",
              "diagnosis_incomplete",
              "integrity_error"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Risk Signals",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/PoolPartFeatures"
          },
          "maxItems": 16,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "repeated_faults"
      ],
      "title": "PoolItemFeatures12",
      "type": "object"
    },
    "PoolLimits": {
      "additionalProperties": false,
      "description": "The pool's configuration as the router may read it: its maximum of instances, its per-instance quota of review\nunits and the overseer-agent profiles the overseer offers.",
      "properties": {
        "max_instances": {
          "maximum": 64,
          "minimum": 2,
          "title": "Max Instances",
          "type": "integer"
        },
        "per_instance_quota": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Per Instance Quota",
          "type": "integer"
        },
        "profiles": {
          "items": {
            "enum": [
              "standard",
              "fast"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Profiles",
          "type": "array"
        }
      },
      "required": [
        "max_instances",
        "per_instance_quota",
        "profiles"
      ],
      "title": "PoolLimits",
      "type": "object"
    },
    "PoolPartFeatures": {
      "additionalProperties": false,
      "description": "One part of a combined answer (one specialist's own transfers, or the combinator's output with what no source\nowns): its repeated faults, risk signals and records, read from its own transfers, and its size.",
      "properties": {
        "features": {
          "anyOf": [
            {
              "$ref": "#/$defs/PoolFeatures"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "repeated_faults": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Repeated Faults",
          "type": "integer"
        },
        "risk_records": {
          "items": {
            "enum": [
              "named_defect",
              "writer_assumption",
              "unchecked_source",
              "stem_method",
              "encoding_conflict",
              "contradiction",
              "withheld_verdict",
              "rejection",
              "diagnosis_incomplete",
              "integrity_error"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Risk Records",
          "type": "array"
        },
        "risk_signals": {
          "items": {
            "enum": [
              "named_defect",
              "writer_assumption",
              "unchecked_source",
              "stem_method",
              "encoding_conflict",
              "contradiction",
              "withheld_verdict",
              "rejection",
              "diagnosis_incomplete",
              "integrity_error"
            ],
            "type": "string"
          },
          "maxItems": 10,
          "title": "Risk Signals",
          "type": "array"
        }
      },
      "required": [
        "repeated_faults"
      ],
      "title": "PoolPartFeatures",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/PoolItemFeatures12"
      },
      "maxItems": 4096,
      "title": "Items",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/PoolLimits"
    },
    "port_version": {
      "const": "1.2",
      "title": "Port Version",
      "type": "string"
    },
    "protocol": {
      "const": "epinoic.integration.v1",
      "title": "Protocol",
      "type": "string"
    },
    "schema": {
      "const": "epinoic.integration.pool-routing-request.v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "protocol",
    "port_version",
    "limits"
  ],
  "title": "PoolRoutingRequest12",
  "type": "object"
}
